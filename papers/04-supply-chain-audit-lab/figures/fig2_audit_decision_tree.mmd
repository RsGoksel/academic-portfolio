%% Figure 2: 10-point audit checklist as a decision tree.
%% Each PASS continues; any FAIL escalates verdict to UNSAFE.
flowchart TD
    Start(["Begin pre-install audit"]) --> C1{"1. Repo metadata<br/>consistent?"}
    C1 -->|FAIL| Unsafe["VERDICT: UNSAFE"]:::unsafe
    C1 -->|PASS| C2{"2. Dependencies<br/>mainstream & pinned?"}
    C2 -->|FAIL| Risky["VERDICT: RISKY"]:::risky
    C2 -->|PASS| C3{"3. Install hooks<br/>absent?"}
    C3 -->|FAIL| Unsafe
    C3 -->|PASS| C4{"4. Dangerous primitives<br/>all benign?"}
    C4 -->|FAIL| Unsafe
    C4 -->|PASS| C5{"5. Outbound network<br/>all expected?"}
    C5 -->|FAIL| Risky
    C5 -->|PASS| C6{"6. Encoded blobs<br/>absent or justified?"}
    C6 -->|FAIL| Unsafe
    C6 -->|PASS| C7{"<b>7. Binary file inventory<br/>only expected files?</b>"}:::critical
    C7 -->|"FAIL<br/>(case study<br/>caught here)"| Unsafe
    C7 -->|PASS| C8{"8. Secrets handled<br/>safely?"}
    C8 -->|FAIL| Unsafe
    C8 -->|PASS| C9{"9. No bundled binaries<br/>or auto-config edits?"}
    C9 -->|FAIL| Risky
    C9 -->|PASS| C10{"10. README matches<br/>code reality?"}
    C10 -->|FAIL| Risky
    C10 -->|PASS| Safe["VERDICT: SAFE TO INSTALL<br/>(in isolated venv)"]:::safe

    classDef safe fill:#d4edda,stroke:#155724,color:#000
    classDef risky fill:#fff3cd,stroke:#856404,color:#000
    classDef unsafe fill:#f8d7da,stroke:#721c24,color:#000
    classDef critical stroke:#721c24,stroke-width:3px,fill:#ffe5e5,color:#000
