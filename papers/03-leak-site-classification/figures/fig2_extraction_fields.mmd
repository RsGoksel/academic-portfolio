    POST[Leak-site post text<br/>+ post metadata]
    POST --> F1
    POST --> F2
    POST --> F3
    POST --> F4
    POST --> F5

    F1[Field 1<br/>Victim industry<br/>NAICS-aligned]
    F1 --> F1V["Manufacturing | Healthcare<br/>Financial Services | Education<br/>Public Administration | Retail<br/>Professional Services | Energy<br/>Other | Unknown"]

    F2[Field 2<br/>Data category claimed leaked]
    F2 --> F2V["PII | PHI | Financial Records<br/>Source Code | Email Archives<br/>Trade Secrets | Operational Data<br/>Mixed/Unspecified | Unknown"]

    F3[Field 3<br/>Negotiation status implied]
    F3 --> F3V["Initial threat<br/>Countdown active<br/>Data published<br/>Negotiation implied succeeded<br/>Unknown"]

    F4[Field 4<br/>Victim size signal]
    F4 --> F4V["Revenue mentioned<br/>Employee count mentioned<br/>Industry rank mentioned<br/>None / Unknown"]

    F5[Field 5<br/>Geographic indicator]
    F5 --> F5V["ISO 3166 country code<br/>or<br/>Unknown<br/>(no sub-national granularity)"]
